# Example environment variables for the Marketing Agency Agent service
# Copy this file to `.env` locally or set these in your hosting provider (Render, Heroku, etc.).
# IMPORTANT: Do NOT commit your real secrets to the repository.

# Required: GROQ API key used by the Groq client (set this in Render secrets)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model name to use (defaults in code if omitted)
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: temperature for the Groq model (float)
GROQ_TEMPERATURE=0.7

# Optional: Google API key (only required if you enable Gemini/Google Vision features)
GOOGLE_API_KEY=
GEMINI_MODEL=

# Server port (Render provides $PORT automatically; override locally if needed)
PORT=8000

# Notes:
# - Replace values above with the real secrets in your deployment provider; never store them in git.
# - For Render, set these under the service's Environment > Environment Variables section.
